{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=.\\SQLEXPRESS;Initial Catalog=OptiStudioDb;Integrated Security=True;TrustServerCertificate=True"
  },
  "JwtSettings": {
    "SecretKey": "REPLACE_WITH_MIN_32_CHAR_SECRET_KEY",
    "Issuer": "OptiStudio",
    "Audience": "OptiStudioClient",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "SmtpSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "SenderEmail": "YOUR_EMAIL@gmail.com",
    "SenderPassword": "YOUR_APP_PASSWORD",
    "SenderName": "OptiStudio",
    "EnableSsl": true
  },
  "AzureBlobSettings": {
    "ConnectionString": "REPLACE_WITH_AZURE_BLOB_CONNECTION_STRING"
  }
}
